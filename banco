create database union_subquery;
USE union_subquery;

create table Cliente
(cod_cli int not null primary key,
Nome_cli varchar(45),
sexo_cli char(1),
Salario_cli decimal(10,2),
constraint sexo check (sexo_cli in ('F','M')));

Create table Professor
(cod_prof int not null primary key,
Nome_prof varchar(45),
salario_prof decimal(10,2));

Create table Aluno
(cod_aluno int not null primary key,
Nome_aluno varchar(45),
sexo_aluno char(1),
constraint sexo1 check (sexo_aluno in ('F','M')));

